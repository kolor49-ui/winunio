{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "winunio.com" }],
      "destination": "https://www.winunio.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/futgen",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/futgen/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/run",
      "schedule": "0 * * * *"
    }
  ]
}
